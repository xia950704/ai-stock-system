# Search API Configuration Template
# Copy this file to .env in the project root and fill in your values.
# DO NOT commit the .env file to version control.

# Base URL for the Search API endpoint
SEARCH_API_BASE_URL=http://127.0.0.1:31415/v1/search

# API Key for authentication (obtain from your search provider)
# The local relay supports multiple providers: Tavily, Exa, Firecrawl, Linkup
# Or use "parallel" mode if enabled (no key needed)
SEARCH_API_KEY=your_api_key_here
